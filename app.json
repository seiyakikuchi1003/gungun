{
  "expo": {
    "name": "ぐんぐん",
    "slug": "gungun",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "gungun",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FDF8F0"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.gungun.ios"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FDF8F0"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
