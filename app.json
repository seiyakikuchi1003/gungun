{
  "expo": {
    "name": "ぐんぐん",
    "slug": "gungun",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "gungun",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FDF8F0"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.gungun.ios",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FDF8F0"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "商品の写真を選ぶために写真ライブラリへのアクセスを許可してください。",
          "cameraPermission": "商品の写真を撮影するためにカメラへのアクセスを許可してください。"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#2C8547"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}