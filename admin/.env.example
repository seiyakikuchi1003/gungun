# ── Supabase 接続 ─────────────────────────────────────
# Supabase ダッシュボード → Project Settings → API から取得
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# service_role キー（★サーバー専用・絶対に公開しない）
# 管理画面は RLS を越えて全データを扱うため必要。
# Cloudflare Pages では「暗号化された環境変数」として設定する。
SUPABASE_SERVICE_ROLE_KEY=

# ── 管理画面へのアクセス制限（暫定）──────────────────
# 公開URLに出すときは必ず設定すること。
# 未設定のときは localhost 以外からのアクセスを 503 で閉じる（fail closed）。
# 裏に service_role キーがあるので、鍵なしで通すより閉じる方を選んでいる。
# ローカル（npm run preview / localhost:3100）では未設定のままで開ける。
ADMIN_PASSWORD=
