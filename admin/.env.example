# ── Supabase 接続 ─────────────────────────────────────
# Supabase ダッシュボード → Project Settings → API から取得
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# service_role キー（★サーバー専用・絶対に公開しない）
# 管理画面は RLS を越えて全データを扱うため必要。
# Cloudflare Pages では「暗号化された環境変数」として設定する。
SUPABASE_SERVICE_ROLE_KEY=

# ── 管理画面へのアクセス制限（暫定）──────────────────
# 未設定だと誰でも開けてしまうため、必ず設定すること。
ADMIN_PASSWORD=
